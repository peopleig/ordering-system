<%- include("../public/partials/head.ejs", { title: "Forgot Password", CSSFile: "/login/style.css" }) %>
<body>
<%- include("../public/partials/navbar.ejs") %>
    <div id="wrapper">
        <div id="cover">
            <form action="/reset" method="POST" class="container mt-5" style="max-width: 400px;">
                <h3 class="text-center mb-4"><b>FORGOT PASSWORD?</b></h3>
                <div class="mb-3">
                    <label class="form-label d-block">Reset Password Using:</label>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="reset_type" id="mobile_option" value="mobile" checked>
                        <label class="form-check-label" for="mobile_option">Mobile Number</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="reset_type" id="email_option" value="email">
                        <label class="form-check-label" for="email_option">Email ID</label>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="identifier" class="form-label">Mobile Number or Email</label>
                    <input type="text" class="form-control" id="identifier" name="identifier" required>
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Send OTP</button>
                </div>
            </form>
            <form action="/login" method="GET">
                <button class="btn btn-outline-success redirect" type="submit">WAIT, I REMEMBER IT NOW!<br>Back to Login!</button>
            </form>
        </div>
    </div>
    <% if (error) { %>
        <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">
            <div class="toast custom-toast show" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        <%=message%>
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    <% } %>
<%- include("../public/partials/footer") %>
<script src="/login/script.js"></script>
</body>
</html>